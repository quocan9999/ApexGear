# ─────────────────────────────────────────────────────────────
# ApexGear API — environment variables
# Copy this file to .env (same folder) and fill in real values.
# Only the API consumes these (web/admin use a hardcoded Vite proxy).
# ─────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ──
# PostgreSQL connection for the active local API database.
# The existing local database is localhost:5432/apexgear.
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/apexgear"

# ── JWT (REQUIRED) ──
# Note: JWT_SECRET and JWT_EXPIRES_IN are deprecated (old 7-day token).
# They are kept here for reference but should be replaced by:
JWT_SECRET="deprecated-do-not-use-in-new-setup"
JWT_EXPIRES_IN="7d"

ACCESS_TOKEN_SECRET="your-super-secret-access-token-key-change-in-production"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-change-in-production"

# ── CORS origins ──
FRONTEND_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# ── Cloudinary (image uploads) ──
# Optional for non-upload flows; required to use the upload feature.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Google OAuth ──
# Optional. Required only if Google sign-in is enabled.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# ── Email / Gmail SMTP (email verification & password reset) ──
# Optional in local dev; required for email verification & password reset flows.
# For Gmail: Use SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", and generate an App Password from Google Account Security.
# SMTP_FROM should use the same Gmail address (or another Gmail-authorized sender) for reliable local delivery.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="ApexGear <your-email@gmail.com>"

# ── SePay (bank-transfer payments) ──
# SEPAY_WEBHOOK_SECRET verifies webhook authenticity (HMAC signature or API key header).
SEPAY_WEBHOOK_SECRET="your-sepay-webhook-secret"
SEPAY_BANK_ACCOUNT="your-bank-account-number"
SEPAY_BANK_ID="MB"

# ── Runtime ──
NODE_ENV="development"
PORT="3001"
