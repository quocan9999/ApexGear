{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "[/\\\\]node_modules[/\\\\](?!htmlparser2|dom-serializer|domhandler|domutils|domelementtype|entities|sanitize-html)"
  ],
  "testTimeout": 30000
}
